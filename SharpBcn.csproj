<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SharpBcn</RootNamespace>
    <PackageId>SharpBcn</PackageId>
    <Authors>bladew0rks</Authors>
    <Description>Fast, high quality BC1-BC5 (DXT1/DXT3/DXT5/ATI1N/ATI2N) texture block compression and decompression in pure C#, using AVX-512 or AVX2 when available.</Description>
    <PackageTags>bcn;dxt;bc1;bc3;bc4;bc5;texture;compression;simd</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md;THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <UsingTask TaskName="GenerateWideSimd" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <ClassName ParameterType="System.String" Required="true" />
      <Width ParameterType="System.Int32" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = System.IO.File.ReadAllText(Source)
            .Replace("Vector256", "Vector" + Width)
            .Replace("class " + ClassName, "class " + ClassName + Width)
            .Replace("public const int Lanes = 8;", "public const int Lanes = " + (Width / 32) + ";");
        if (!System.IO.File.Exists(Destination) || System.IO.File.ReadAllText(Destination) != text)
        {
            System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Destination));
            System.IO.File.WriteAllText(Destination, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBcEncoderSimd512" BeforeTargets="CoreCompile">
    <GenerateWideSimd Source="$(MSBuildProjectDirectory)/BcEncoderSimd.cs" Destination="$(IntermediateOutputPath)BcEncoderSimd512.g.cs" ClassName="BcEncoderSimd" Width="512" />
    <GenerateWideSimd Source="$(MSBuildProjectDirectory)/Bc7EncoderSimd.cs" Destination="$(IntermediateOutputPath)Bc7EncoderSimd512.g.cs" ClassName="Bc7EncoderSimd" Width="512" />
    <GenerateWideSimd Source="$(MSBuildProjectDirectory)/Bc7EncoderSimd.cs" Destination="$(IntermediateOutputPath)Bc7EncoderSimd128.g.cs" ClassName="Bc7EncoderSimd" Width="128" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BcEncoderSimd512.g.cs;$(IntermediateOutputPath)Bc7EncoderSimd512.g.cs;$(IntermediateOutputPath)Bc7EncoderSimd128.g.cs" />
    </ItemGroup>
  </Target>

</Project>
